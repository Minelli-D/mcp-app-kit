# The settings of this app. No secret is in this file: the password and the keys are made by
# k8s/deploy.sh and live in a Kubernetes Secret (k8s/show.sh shows the login).
# One setting per line, NAME=value. A "#" starts a comment. No quotes are needed.

# The name of the app in Kubernetes: every object, the images, the Secret and the database
# are named after it. Lower-case letters, digits and "-", it starts with a letter, at most 40.
APP_NAME=my-app

# The name of the app on the login page and on the page where an MCP client asks to connect.
APP_TITLE=My App

# The public name of the app and of the login.
APP_HOST=app.example.com

# The public name for MCP clients (ChatGPT, Claude): their address is https://<MCP_HOST>/mcp.
# It may be the same as APP_HOST: then /mcp is on the name of the app.
MCP_HOST=mcp.example.com

# The one user. Nobody else can sign up or log in.
LOGIN_EMAIL=me@example.com

# Where it runs. Every kubectl call of every script names this context, so nothing can reach
# another cluster by accident. See: kubectl config get-contexts
K8S_CONTEXT=my-cluster
K8S_NAMESPACE=my-namespace

# Where the images are pushed: host/project. You must be logged in there (docker login).
REGISTRY=registry.example.com/project

# The name of the Secret with the login of the registry, when the cluster needs one to pull
# the images. Empty: none.
PULL_SECRET=

# The storage class of the volumes. Empty: the default class of the cluster.
STORAGE_CLASS=

# The size of the volume with the files that the MCP server and the app share.
STORAGE_SIZE=1Gi

# The public door. INGRESS=no leaves the Ingress out: everything runs, but there is no public
# address and no certificate yet.
INGRESS=yes
INGRESS_CLASS=nginx
CLUSTER_ISSUER=letsencrypt

# The namespace where the ingress controller runs. A network rule lets only that namespace
# reach the gateway.
INGRESS_NAMESPACE=ingress-nginx

# The database of the login server.
#   own       the kit runs a small Postgres of its own, next to the app (the usual choice)
#   existing  a Postgres that is already in the namespace: POSTGRES_POD is its pod (the
#             database script runs inside it, as its superuser) and POSTGRES_SERVICE is the
#             name that the login server connects to
POSTGRES_MODE=own
POSTGRES_POD=
POSTGRES_SERVICE=

# The MCP server behind the bridge: the npm packages to install, and the command that starts
# it over standard input and output. /data is the volume that the app sees too.
MCP_PACKAGES=@modelcontextprotocol/server-filesystem@2026.8.31
MCP_COMMAND=mcp-server-filesystem /data

# The MCP protocol versions that the gateway lets through to the bridge. An MCP client that
# asks in another version (ChatGPT asks in 2026-07-28 first) gets the answer of an older MCP
# server, "Unsupported protocol version", and goes on with the older handshake. Add a version
# only when the MCP server above can really answer it.
MCP_VERSIONS=2025-11-25,2025-06-18,2025-03-26,2024-11-05,2024-10-07

# The paths of the app that anybody may read without the login: its stylesheet, its pictures.
# They must hold nothing private. An entry that ends with "/" opens everything under it.
OPEN_PATHS=/static/
